<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lertaro.Plugins.DoubleCommander</AssemblyName>
    <RootNamespace>Lertaro.Plugins.DoubleCommander</RootNamespace>
    <!-- Fallback only: builds derive the version from the newest v* git tag (see SetVersionFromGitTag),
         and a release can override it with -p:Version=<tag>. Keep this value equal to the latest released
         tag; the Build workflow fails when it falls behind. -->
    <Version>9.9.9</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <LertaroRoot Condition="'$(LertaroRoot)' == ''">$(MSBuildProjectDirectory)\..\..\Lertaro</LertaroRoot>
    <LertaroProject>$(LertaroRoot)\PluginSdk\PluginSdk.csproj</LertaroProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(LertaroProject)')">
    <!-- Release builds pass -p:Version=<tag>; without this the value flows into the referenced SDK
         project and the plugin ends up referencing e.g. Lertaro.PluginSdk 0.1.4 instead of the
         installed 1.8.6. Keep the SDK's own versioning. -->
    <ProjectReference Include="$(LertaroProject)" Private="false"
                      GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;VersionPrefix;VersionSuffix" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(LertaroProject)') and '$(LertaroSdkDll)' != ''">
    <Reference Include="Lertaro.PluginSdk">
      <HintPath>$(LertaroSdkDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateLertaroSdk" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(LertaroProject)') and '$(LertaroSdkDll)' == ''"
      Text="找不到 Lertaro.PluginSdk。请使用 -p:LertaroRoot=官方 Lertaro 源码目录，或使用 -p:LertaroSdkDll=已安装的 Lertaro.PluginSdk.dll。" />
  </Target>

  <Target Name="CopyToLertaro" AfterTargets="Build" Condition="Exists('$(LertaroRoot)')">
    <PropertyGroup>
      <LertaroPluginDirectory>$(LertaroRoot)\App\bin\$(Configuration)\net10.0-windows\Plugins\DoubleCommander</LertaroPluginDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(LertaroPluginDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LertaroPluginDirectory)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The version of a release is its git tag (v1.2.3). Builds that do not pass -p:Version derive the version
    from the newest reachable v* tag, so CI artifacts and local builds report the release the commit belongs
    to instead of a value someone remembered to edit. Environments without git (source export) or without
    tags (shallow clone) keep the <Version> fallback above.

    -p:Version=<tag> (used by the release workflow) is a global MSBuild property and always wins, both here
    and for the three derived properties below.
  -->
  <Target Name="SetVersionFromGitTag" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git describe --tags --match &quot;v*&quot; --abbrev=0"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribeOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitDescribeExitCode)' == '0' and '$(_GitDescribeOutput)' != ''">
      <Version>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribeOutput)', '^v', '').Trim())</Version>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
